proxy_cache_path /var/cache/nginx/bbh levels=1:2 keys_zone=bbh_cache:10m max_size=500m inactive=10m use_temp_path=off;

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name balibestholiday.com www.balibestholiday.com;

  ssl_certificate     /etc/letsencrypt/live/balibestholiday.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/balibestholiday.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header X-Cache-Status $upstream_cache_status always;

  gzip on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 256;
  gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss image/svg+xml font/woff font/woff2;
  gzip_proxied any;


  client_max_body_size 5M;
  client_body_timeout 60s;

  # Static files: 1 year cache
  location /_next/static/ {
    proxy_pass http://nextjs_upstream;
    expires 365d;
    add_header Cache-Control "public, max-age=31536000, immutable";
    proxy_cache bbh_cache;
    proxy_cache_valid 200 365d;
  }

  location /_next/image {
    proxy_pass http://nextjs_upstream;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
    proxy_cache bbh_cache;
    proxy_cache_valid 200 30d;
  }

  # Static assets (favicon, robots, etc.)
  location ~* \.(ico|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|eot)$ {
    proxy_pass http://nextjs_upstream;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
    proxy_cache bbh_cache;
    proxy_cache_valid 200 7d;
  }

  # API: never cache user-specific responses
  location /api/duffel/ {
    limit_req zone=duffel burst=20 nodelay;
    limit_req_status 429;
    proxy_pass http://nextjs_upstream;
    include /etc/nginx/conf.d/proxy-common.inc;
  }

  location /api/ {
    limit_req zone=api burst=60 nodelay;
    limit_req_status 429;
    proxy_pass http://nextjs_upstream;
    include /etc/nginx/conf.d/proxy-common.inc;
  }

  # HTML pages: micro-cache 30s for anonymous users (huge speedup for hot pages)
  location / {
    proxy_pass http://nextjs_upstream;
    include /etc/nginx/conf.d/proxy-common.inc;

    # Cache only GET requests without auth cookie
    proxy_cache bbh_cache;
    proxy_cache_methods GET HEAD;
    proxy_cache_valid 200 30s;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 5s;
    proxy_ignore_headers Set-Cookie Cache-Control Vary Expires;
    proxy_hide_header Vary;
    proxy_cache_bypass $http_authorization $cookie_session_id $cookie_next_auth_session_token;
    proxy_no_cache $http_authorization $cookie_session_id $cookie_next_auth_session_token;
    proxy_cache_key "$scheme$request_method$host$request_uri$cookie_next_locale$cookie_user_currency";
  }

  location = /health {
    access_log off;
    return 200 "ok\n";
    add_header Content-Type text/plain;
  }
}
