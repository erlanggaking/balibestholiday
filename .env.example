# ----------------------------------------------------------
# Bali Best Holiday — Environment Variables
# Copy ke .env dan isi sesuai kredensial lu
# ----------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bali_best_holiday?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-string-random-32-karakter-atau-lebih"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Email (SMTP) — buat verifikasi & invoice
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Bali Best Holiday <noreply@balibestholiday.com>"

# Currency exchange rate API (opsional, fallback ke seed)
EXCHANGE_RATE_API_KEY=""

# Duffel API — flights & stays (https://duffel.com)
DUFFEL_ACCESS_TOKEN=""

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Bali Best Holiday"
