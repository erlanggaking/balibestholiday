# ============================================================
# Bali Best Holiday — Environment Variables
# Copy ke .env (lokal) atau set di Vercel → Settings → Environment Variables
# ============================================================

# -- Database (Supabase Postgres) --
# Ambil dari Supabase: Project Settings → Database → Connection String
# - DATABASE_URL: gunakan "Connection pooling" (port 6543) + tambah ?pgbouncer=true&connection_limit=1
# - DIRECT_URL  : gunakan "Connection string" (port 5432) — buat Prisma Migrate
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# -- NextAuth --
# Production: set NEXTAUTH_URL ke domain Vercel-mu (https://...)
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GANTI-DENGAN-32-CHAR-RANDOM-OPENSSL-RAND-BASE64-32"

# -- OAuth providers (opsional) --
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# -- Stripe (opsional) --
# Test: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# -- SMTP (opsional, buat invoice & verifikasi email) --
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Bali Best Holiday <noreply@balibestholiday.com>"

# -- Currency exchange rate API (opsional) --
EXCHANGE_RATE_API_KEY=""

# -- Duffel API (flights & stays) --
# https://duffel.com/dashboard → Developers → Access tokens
DUFFEL_ACCESS_TOKEN="duffel_test_xxxxx"

# -- Public site --
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Bali Best Holiday"
